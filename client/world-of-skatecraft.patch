new file mode 100644
index 00000000..fa4fd811
--- /dev/null
+++ b/tools/test-skate-multiplayer.ps1
@@ -0,0 +1,61 @@
+param(
+    [switch]$Probe,
+    [switch]$Idle,
+    [int]$Seconds = 75,
+    [string]$IdentityFile = '.setup/multiplayer-test/identities.json'
+)
+$ErrorActionPreference = 'Stop'
+$clientRoot = Split-Path $PSScriptRoot -Parent
+Set-Location $clientRoot
+$identities = @(Get-Content -LiteralPath $IdentityFile | ConvertFrom-Json)
+if ($identities.Count -ne 2 -or $identities[0].user -eq $identities[1].user) {
+    throw 'Supply exactly two distinct test accounts in the identity JSON.'
+}
+$runDirectory = Join-Path $clientRoot ('.setup/multiplayer-test/run-' + (Get-Date -Format 'yyyyMMdd-HHmmss'))
+New-Item -ItemType Directory -Path $runDirectory | Out-Null
+# A copy keeps a test run from locking the normal launcher binary during development.
+Copy-Item 'target/release/benilla.exe' (Join-Path $runDirectory 'benilla.exe')
+$env:WOW_HOST = 'localhost:3725'
+$env:WOW_REALM = 'VMaNGOS'
+$env:WOW_DATA = 'C:\World of Warcraft Classic\Data'
+$env:WOW_SKATE_ASSETS = Join-Path $clientRoot 'skate-data/assets'
+$env:WOW_SKATE_AUDIO = Join-Path $clientRoot 'skate-audio'
+$env:WOW_SKATE_MULTIPLAYER = '1'
+$env:WOW_WIN = '960x540'
+$env:RUST_LOG = 'warn,benilla_app::skate=info,benilla_app::net::session=info,benilla_app::capture=info,bevy_render::view::window::screenshot=info'
+$results = @()
+for ($i=0; $i -lt 2; $i++) {
+    $identity = $identities[$i]
+    $characterDirectory = Join-Path $runDirectory $identity.character
+    New-Item -ItemType Directory -Path $characterDirectory | Out-Null
+    $env:WOW_USER = $identity.user
+    $env:WOW_PASS = $identity.password
+    $env:WOW_CHAR = $identity.character
+    $env:BENILLA_HOME = Join-Path $clientRoot ('.setup/multiplayer-test/' + $identity.character + '/config')
+    # Both accounts are deliberately separate from the user's account.
+    $env:WOW_ALLOW_ACCOUNT = '1'
+    if ($Probe) {
+        $env:WOW_UNATTENDED = '1'
+        $env:WOW_NOSOUND = '1'
+        $env:WOW_SKATE_AUTOSTART = '5'
+        $env:WOW_SKATE_PROBE = if ($Idle) { '0' } else { '1' }
+        $env:WOW_PROBE_EXIT_AT = "$Seconds"
+        $env:WOW_LIVE_SHOT = Join-Path $characterDirectory 'view.png'
+        $env:WOW_LIVE_SHOT_AT = '25'
+        $env:WOW_LIVE_SHOT_COUNT = '5'
+        $env:WOW_LIVE_SHOT_EVERY = '8'
+        $env:WOW_PROBE_CAM = '0,-22,20@5'
+        # Exercise dismount after the first captures. Input is the real J key path.
+        $env:WOW_PROBE_KEY = 'J@32;J@38'
+    } else {
+        foreach ($name in @('WOW_UNATTENDED','WOW_NOSOUND','WOW_SKATE_AUTOSTART','WOW_SKATE_PROBE','WOW_PROBE_EXIT_AT','WOW_LIVE_SHOT','WOW_LIVE_SHOT_AT','WOW_LIVE_SHOT_COUNT','WOW_LIVE_SHOT_EVERY','WOW_PROBE_CAM','WOW_PROBE_KEY')) {
+            [Environment]::SetEnvironmentVariable($name, $null, 'Process')
+        }
+    }
+    $process = Start-Process -FilePath (Join-Path $runDirectory 'benilla.exe') -WorkingDirectory $clientRoot -PassThru `
+        -RedirectStandardOutput (Join-Path $characterDirectory 'stdout.log') `
+        -RedirectStandardError (Join-Path $characterDirectory 'stderr.log')
+    $results += [pscustomobject]@{ character=$identity.character; pid=$process.Id; directory=$characterDirectory }
+}
+$results | ConvertTo-Json | Set-Content (Join-Path $runDirectory 'processes.json')
+$results
