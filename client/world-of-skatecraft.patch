diff --git a/crates/benilla-app/src/skate/network.rs b/crates/benilla-app/src/skate/network.rs
new file mode 100644
index 00000000..0a52608e
--- /dev/null
+++ b/crates/benilla-app/src/skate/network.rs
@@ -0,0 +1,286 @@
+//! Authenticated pose replication at 20 Hz, rendered 100 ms behind arrival.
+use super::{SkatePose, METERS_PER_YARD};
+use crate::net::{ClientCommand, GuidIndex, NetCommands, NetHandlerApp, SelfGuid};
+use benilla_protocol::{skate as wire, SessionEvent, SessionEventKind};
+use benilla_world::world_map::CurrentMap;
+use bevy::prelude::*;
+use std::collections::{HashMap, VecDeque};
+
+#[derive(Component)]
+pub(super) struct RemoteSkate(pub SkatePose);
+
+struct Peer {
+    sequence: u32,
+    frames: VecDeque<(f32, SkatePose)>,
+}
+
+#[derive(Resource, Default)]
+pub(super) struct Replication {
+    identity: Option<(u64, u32)>,
+    ready: bool,
+    sequence: u32,
+    sent_at: f32,
+    was_active: bool,
+    peers: HashMap<u64, Peer>,
+    received: u64,
+}
+
+fn pack(m: Mat4) -> wire::Transform {
+    let (scale, rotation, position) = m.to_scale_rotation_translation();
+    wire::Transform {
+        position: position.to_array(),
+        rotation: rotation.normalize().to_array(),
+        scale: scale.to_array(),
+    }
+}
+fn unpack(t: &wire::Transform) -> Mat4 {
+    Mat4::from_scale_rotation_translation(
+        Vec3::from_array(t.scale),
+        Quat::from_array(t.rotation).normalize(),
+        Vec3::from_array(t.position),
+    )
+}
+
+fn receive(In(ev): In<SessionEvent>, time: Res<Time>, mut state: ResMut<Replication>) {
+    let SessionEvent::Skate { guid, frame } = ev else {
+        return;
+    };
+    if guid == 0 && frame.kind == 0 {
+        if state.identity.is_some_and(|(_, map)| map == frame.map) {
+            state.ready = true;
+            info!("skate multiplayer: protocol v1 accepted");
+        }
+        return;
+    }
+    if !state.ready
+        || !state
+            .identity
+            .is_some_and(|(own, map)| own != guid && map == frame.map)
+    {
+        return;
+    }
+    if frame.kind == 2 {
+        state.peers.remove(&guid);
+        return;
+    }
+    let Some(p) = frame.pose else {
+        return;
+    };
+    let peer = state.peers.entry(guid).or_insert_with(|| Peer {
+        sequence: 0,
+        frames: VecDeque::new(),
+    });
+    if frame.sequence <= peer.sequence {
+        return;
+    }
+    peer.sequence = frame.sequence;
+    peer.frames.push_back((
+        time.elapsed_secs(),
+        SkatePose {
+            active: true,
+            origin: Vec3::from_array(p.origin),
+            root: unpack(&p.root),
+            bones: p.bones.iter().map(|(_, t)| unpack(t)).collect(),
+            names: p.bones.into_iter().map(|(n, _)| n).collect(),
+        },
+    ));
+    while peer.frames.len() > 8 {
+        peer.frames.pop_front();
+    }
+    state.received += 1;
+    if state.received == 1 || state.received.is_multiple_of(100) {
+        info!(
+            "skate multiplayer: received {} poses, latest peer={guid}",
+            state.received
+        );
+    }
+}
+
+fn blend(a: Mat4, b: Mat4, t: f32) -> Mat4 {
+    let (sa, qa, pa) = a.to_scale_rotation_translation();
+    let (sb, qb, pb) = b.to_scale_rotation_translation();
+    Mat4::from_scale_rotation_translation(sa.lerp(sb, t), qa.slerp(qb, t), pa.lerp(pb, t))
+}
+fn sample(frames: &VecDeque<(f32, SkatePose)>, at: f32) -> Option<SkatePose> {
+    let mut before = frames.front()?;
+    for after in frames.iter().skip(1) {
+        if after.0 >= at {
+            if before.1.names != after.1.names || before.1.origin != after.1.origin {
+                return Some(after.1.clone());
+            }
+            let t = ((at - before.0) / (after.0 - before.0).max(0.001)).clamp(0.0, 1.0);
+            let mut p = after.1.clone();
+            p.root = blend(before.1.root, after.1.root, t);
+            for (out, a) in p.bones.iter_mut().zip(&before.1.bones) {
+                *out = blend(*a, *out, t);
+            }
+            return Some(p);
+        }
+        before = after;
+    }
+    Some(before.1.clone())
+}
+
+#[allow(clippy::too_many_arguments)]
+pub(super) fn update(
+    time: Res<Time>,
+    pose: Res<SkatePose>,
+    player: Res<crate::player::Player>,
+    own: Res<SelfGuid>,
+    map: Option<Res<CurrentMap>>,
+    net: Res<NetCommands>,
+    index: Res<GuidIndex>,
+    mut state: ResMut<Replication>,
+    mut commands: Commands,
+    existing: Query<Entity, With<RemoteSkate>>,
+) {
+    let now = time.elapsed_secs();
+    let identity = own
+        .0
+        .zip(map.as_ref().map(|m| m.0))
+        .filter(|_| player.active);
+    if state.identity != identity {
+        *state = Replication {
+            identity,
+            ..default()
+        };
+        if let Some((_, map)) = identity {
+            // Opt in explicitly: this opcode is not part of stock WoW.
+            if std::env::var("WOW_SKATE_MULTIPLAYER").is_ok_and(|v| v == "1") {
+                let _ = net.0.send(ClientCommand::Skate(wire::Frame {
+                    kind: 0,
+                    sequence: 0,
+                    map,
+                    pose: None,
+                }));
+            }
+        }
+    }
+    if state.ready && (pose.active || state.was_active) && now - state.sent_at >= 0.05 {
+        state.sequence = state.sequence.wrapping_add(1);
+        let frame = wire::Frame {
+            kind: if pose.active { 1 } else { 2 },
+            sequence: state.sequence,
+            map: identity.unwrap().1,
+            pose: pose.active.then(|| wire::Pose {
+                origin: pose.origin.to_array(),
+                root: pack(pose.root),
+                bones: pose
+                    .names
+                    .iter()
+                    .cloned()
+                    .zip(pose.bones.iter().copied().map(pack))
+                    .collect(),
+            }),
+        };
+        match frame.encode() {
+            Ok(_) => {
+                let _ = net.0.send(ClientCommand::Skate(frame));
+            }
+            Err(e) => {
+                bevy::log::warn_once!("skate multiplayer: cannot encode local pose: {e}");
+            }
+        }
+        state.sent_at = now;
+        state.was_active = pose.active;
+    }
+    state.peers.retain(|guid, peer| {
+        index.0.contains_key(guid) && peer.frames.back().is_some_and(|(t, _)| now - t < 1.0)
+    });
+    let mut active = std::collections::HashSet::new();
+    for (guid, peer) in &state.peers {
+        if let (Some(entity), Some(pose)) = (index.0.get(guid), sample(&peer.frames, now - 0.1)) {
+            active.insert(*entity);
+            commands.entity(*entity).insert(RemoteSkate(pose));
+        }
+    }
+    for entity in &existing {
+        if !active.contains(&entity) {
+            commands.entity(entity).remove::<RemoteSkate>();
+        }
+    }
+}
+
+// Normal WoW movement may extrapolate while the skater is still in the air. The pose's
+// root wins for remote rendering; the server's movement remains the gameplay position.
+pub(super) fn place(mut units: Query<(&RemoteSkate, &mut Transform)>) {
+    for (pose, mut transform) in &mut units {
+        transform.translation = pose.0.origin + pose.0.root.w_axis.truncate() / METERS_PER_YARD;
+    }
+}
+
+pub(super) fn plugin(app: &mut App) {
+    app.add_systems(
+        Update,
+        reset_on_transition.before(benilla_world::schedule::WorldStage::Input),
+    )
+    .init_resource::<Replication>()
+    .net_handler(SessionEventKind::Skate, receive);
+}
+
+/// Reset even while the in-world update set is gated off (logout, loading, reconnect).
+fn reset_on_transition(
+    mut disconnected: MessageReader<crate::net::DisconnectedMessage>,
+    mut logged_out: MessageReader<crate::net::LoggedOutMessage>,
+    mut teleports: MessageReader<crate::net::TeleportMessage>,
+    mut worldports: MessageReader<crate::net::WorldportMessage>,
+    mut state: ResMut<Replication>,
+    mut host: ResMut<super::Host>,
+    mut drive: ResMut<super::SkateDrive>,
+    mut pose: ResMut<SkatePose>,
+    peers: Query<Entity, With<RemoteSkate>>,
+    mut commands: Commands,
+) {
+    let reset = disconnected.read().count()
+        + logged_out.read().count()
+        + teleports.read().count()
+        + worldports.read().count()
+        > 0;
+    if reset {
+        *state = Replication::default();
+        super::stop(&mut host, &mut drive, &mut pose);
+        for e in &peers {
+            commands.entity(e).remove::<RemoteSkate>();
+        }
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[test]
+    fn samples_between_packets_and_holds_at_the_edges() {
+        let a = SkatePose {
+            active: true,
+            root: Mat4::IDENTITY,
+            bones: vec![Mat4::IDENTITY],
+            names: vec!["HIPS".into()],
+            ..default()
+        };
+        let mut b = a.clone();
+        b.root = Mat4::from_translation(Vec3::X * 10.0);
+        b.bones[0] = Mat4::from_rotation_y(std::f32::consts::FRAC_PI_2);
+        let frames = VecDeque::from([(1.0, a), (1.1, b)]);
+        let mid = sample(&frames, 1.05).unwrap();
+        assert!((mid.root.w_axis.x - 5.0).abs() < 0.001);
+        let direction = mid.bones[0].transform_vector3(Vec3::Z);
+        assert!((direction.x - std::f32::consts::FRAC_1_SQRT_2).abs() < 0.001);
+        assert_eq!(sample(&frames, 0.0).unwrap().root.w_axis.x, 0.0);
+        assert_eq!(sample(&frames, 2.0).unwrap().root.w_axis.x, 10.0);
+    }
+
+    #[test]
+    fn a_new_origin_is_not_blended_through_the_old_world_space() {
+        let a = SkatePose {
+            root: Mat4::IDENTITY,
+            ..default()
+        };
+        let b = SkatePose {
+            origin: Vec3::X * 1000.0,
+            ..a.clone()
+        };
+        let frames = VecDeque::from([(1.0, a), (1.1, b)]);
+        assert_eq!(sample(&frames, 1.05).unwrap().origin.x, 1000.0);
+    }
+}
