diff --git a/crates/benilla-protocol/src/skate.rs b/crates/benilla-protocol/src/skate.rs
new file mode 100644
index 00000000..d71e9c60
--- /dev/null
+++ b/crates/benilla-protocol/src/skate.rs
@@ -0,0 +1,198 @@
+//! Negotiated World of Skatecraft pose extension. All numbers are little endian.
+//! A server relay prepends the authenticated sender's u64 GUID (zero for HELLO ack).
+use crate::wire::{read_f32_le, read_u16_le, read_u32_le, read_u8};
+use std::io::{self, Read};
+
+pub const CMSG_SKATE: u16 = 828;
+pub const SMSG_SKATE: u16 = 829;
+pub const MAX_BYTES: usize = 10000;
+
+#[derive(Debug, Clone, PartialEq)]
+pub struct Transform {
+    pub position: [f32; 3],
+    pub rotation: [f32; 4],
+    pub scale: [f32; 3],
+}
+
+#[derive(Debug, Clone, PartialEq)]
+pub struct Pose {
+    pub origin: [f32; 3],
+    pub root: Transform,
+    pub bones: Vec<(String, Transform)>,
+}
+
+#[derive(Debug, Clone, PartialEq)]
+pub struct Frame {
+    /// 0: hello/ack; 1: pose; 2: stopped.
+    pub kind: u8,
+    pub sequence: u32,
+    pub map: u32,
+    pub pose: Option<Pose>,
+}
+
+fn invalid() -> io::Error {
+    io::Error::new(io::ErrorKind::InvalidData, "invalid skating frame")
+}
+fn read_transform(r: &mut &[u8], bound: f32) -> io::Result<Transform> {
+    let mut values = [0.0; 10];
+    for v in &mut values {
+        *v = read_f32_le(r)?;
+    }
+    let t = Transform {
+        position: values[..3].try_into().unwrap(),
+        rotation: values[3..7].try_into().unwrap(),
+        scale: values[7..].try_into().unwrap(),
+    };
+    let norm: f32 = t.rotation.iter().map(|x| x * x).sum();
+    if values.iter().any(|x| !x.is_finite())
+        || t.position.iter().any(|x| x.abs() > bound)
+        || !(0.98..1.02).contains(&norm)
+        || t.scale.iter().any(|x| *x < 0.01 || *x > 10.0)
+    {
+        return Err(invalid());
+    }
+    Ok(t)
+}
+
+impl Frame {
+    pub fn decode(mut r: &[u8]) -> io::Result<Self> {
+        if r.len() > MAX_BYTES || read_u8(&mut r)? != 1 {
+            return Err(invalid());
+        }
+        let kind = read_u8(&mut r)?;
+        let sequence = read_u32_le(&mut r)?;
+        let map = read_u32_le(&mut r)?;
+        let pose = match kind {
+            0 | 2 => None,
+            1 => {
+                let mut origin = [0.0; 3];
+                for v in &mut origin {
+                    *v = read_f32_le(&mut r)?;
+                    if !v.is_finite() || v.abs() > 50000.0 {
+                        return Err(invalid());
+                    }
+                }
+                let root = read_transform(&mut r, 100000.0)?;
+                let count = read_u16_le(&mut r)?;
+                if count == 0 || count > 96 {
+                    return Err(invalid());
+                }
+                let mut bones = Vec::with_capacity(count as usize);
+                let mut names = std::collections::HashSet::new();
+                for _ in 0..count {
+                    let n = read_u8(&mut r)? as usize;
+                    if n == 0 || n > 48 {
+                        return Err(invalid());
+                    }
+                    let mut name = vec![0; n];
+                    r.read_exact(&mut name)?;
+                    if name
+                        .iter()
+                        .any(|b| !b.is_ascii_uppercase() && !b.is_ascii_digit() && *b != b'_')
+                    {
+                        return Err(invalid());
+                    }
+                    let name = String::from_utf8(name).map_err(|_| invalid())?;
+                    if !names.insert(name.clone()) {
+                        return Err(invalid());
+                    }
+                    bones.push((name, read_transform(&mut r, 100.0)?));
+                }
+                Some(Pose {
+                    origin,
+                    root,
+                    bones,
+                })
+            }
+            _ => return Err(invalid()),
+        };
+        if !r.is_empty() {
+            return Err(invalid());
+        }
+        Ok(Self {
+            kind,
+            sequence,
+            map,
+            pose,
+        })
+    }
+
+    pub fn encode(&self) -> io::Result<Vec<u8>> {
+        let mut b = vec![1, self.kind];
+        b.extend(self.sequence.to_le_bytes());
+        b.extend(self.map.to_le_bytes());
+        if let Some(p) = &self.pose {
+            if p.bones.len() > 96 {
+                return Err(invalid());
+            }
+            for v in p.origin {
+                b.extend(v.to_le_bytes());
+            }
+            fn put(b: &mut Vec<u8>, t: &Transform) {
+                for v in t.position.iter().chain(&t.rotation).chain(&t.scale) {
+                    b.extend(v.to_le_bytes());
+                }
+            }
+            put(&mut b, &p.root);
+            b.extend((p.bones.len() as u16).to_le_bytes());
+            for (name, t) in &p.bones {
+                if name.len() > 48 {
+                    return Err(invalid());
+                }
+                b.push(name.len() as u8);
+                b.extend(name.as_bytes());
+                put(&mut b, t);
+            }
+        }
+        Self::decode(&b)?;
+        Ok(b)
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    fn sample() -> Frame {
+        let t = Transform {
+            position: [0.; 3],
+            rotation: [0., 0., 0., 1.],
+            scale: [1.; 3],
+        };
+        Frame {
+            kind: 1,
+            sequence: 7,
+            map: 0,
+            pose: Some(Pose {
+                origin: [0.; 3],
+                root: t.clone(),
+                bones: vec![("HIPS".into(), t)],
+            }),
+        }
+    }
+    #[test]
+    fn roundtrip_and_all_truncations() {
+        let f = sample();
+        let b = f.encode().unwrap();
+        assert_eq!(Frame::decode(&b).unwrap(), f);
+        for n in 0..b.len() {
+            assert!(Frame::decode(&b[..n]).is_err());
+        }
+        let mut trailing = b;
+        trailing.push(0);
+        assert!(Frame::decode(&trailing).is_err());
+    }
+    #[test]
+    fn rejects_bad_pose_and_layout() {
+        let mut f = sample();
+        f.pose.as_mut().unwrap().root.rotation = [0.; 4];
+        assert!(f.encode().is_err());
+        let mut f = sample();
+        f.pose.as_mut().unwrap().origin[0] = f32::NAN;
+        assert!(f.encode().is_err());
+        let mut f = sample();
+        let b = f.pose.as_ref().unwrap().bones[0].clone();
+        f.pose.as_mut().unwrap().bones.push(b);
+        assert!(f.encode().is_err());
+        assert!(Frame::decode(&vec![0; MAX_BYTES + 1]).is_err());
+    }
+}
